datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  points        Int        @default(0)
  activities    Activity[]
  badges        Badge[]    @relation("UserBadges")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  category    String
  points      Int
  proofImage  String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  imageUrl    String
  threshold   Int
  users       User[]   @relation("UserBadges")
  createdAt   DateTime @default(now())
}

